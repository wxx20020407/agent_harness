# 基于官方 opencode 镜像，预置离线依赖（无需 npm registry 访问）
# 使用 digest 锁定版本，避免每次构建都检查远程更新
ARG OPENCODE_IMAGE=ghcr.io/anomalyco/opencode@sha256:2d858713458a7aedd448a9ddf8e0a23a7600c84492f15b56ceaf237260611317
FROM ${OPENCODE_IMAGE}

# 换国内 Alpine 镜像 + 安装 Python3 + 文件处理工具链 + 搜索工具
RUN sed -i 's|https://dl-cdn.alpinelinux.org|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apk/repositories && \
    apk add --no-cache \
      python3 \
      py3-pip \
      git \
      ripgrep \
      && \
    pip3 install --break-system-packages \
      openpyxl \
      pymupdf \
      python-docx \
      python-pptx \
      -i https://pypi.tuna.tsinghua.edu.cn/simple

# 配置 pip 默认使用清华源，agent 运行时可直接 pip install
RUN mkdir -p /root/.config/pip && \
    printf '[global]\nindex-url = https://pypi.tuna.tsinghua.edu.cn/simple\ntrusted-host = pypi.tuna.tsinghua.edu.cn\nbreak-system-packages = true\n' \
      > /root/.config/pip/pip.conf

# opencode 启动时会运行 `opencode install` 来安装 opencode-anthropic-auth 插件
# 该命令在离线环境会永久挂起。预置一个 dummy 模块让 opencode 正常加载。
RUN mkdir -p /root/.cache/opencode/node_modules/opencode-anthropic-auth && \
    echo '{"name":"opencode-anthropic-auth","version":"0.0.13","main":"index.js"}' \
      > /root/.cache/opencode/node_modules/opencode-anthropic-auth/package.json && \
    printf 'function plugin(input){return{};}\nmodule.exports=plugin;\n' \
      > /root/.cache/opencode/node_modules/opencode-anthropic-auth/index.js && \
    echo '{"dependencies":{"opencode-anthropic-auth":"0.0.13"}}' \
      > /root/.cache/opencode/package.json
