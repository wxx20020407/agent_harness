# ============================================================
# Agent Harness 环境变量配置
# 复制为 .env 后填写真实值：cp .env.example .env
# ============================================================

# opencode Docker 镜像名（已 docker load 到本地的镜像名:tag）
OPENCODE_IMAGE=ghcr.io/sst/opencode:latest

# ============================================================
# LLM 配置
# ============================================================
# 内网 LLM 服务（OpenAI 兼容接口，如 vLLM / Ollama / OneAPI / FastChat 等）
# 注意：opencode 不读 OPENAI_BASE_URL，必须用这两个变量
LLM_BASE_URL=https://your-internal-llm/v1
LLM_API_KEY=your-key-here

# 主模型（用于主对话）
LLM_PRIMARY_MODEL=zhipuai/glm-5

# 辅助模型（用于记忆系统等后台任务，建议使用更轻量的模型）
# 如果不设置，默认使用与主模型相同的 base_url 和 api_key
LLM_HELPER_MODEL=zhipuai/glm-4-flash
# LLM_HELPER_BASE_URL=（可选，默认与主模型相同）
# LLM_HELPER_API_KEY=（可选，默认与主模型相同）

# ============================================================
# 记忆系统配置
# ============================================================
# 禁用自动记忆功能（设为 1 或 true 禁用）
# CLAUDE_CODE_DISABLE_AUTO_MEMORY=0

# 自定义记忆目录（可选，默认为项目目录下的 .claude/memory）
# CLAUDE_MEMORY_DIR=/path/to/memory

# 自定义 transcripts 目录（可选）
# CLAUDE_TRANSCRIPTS_DIR=/path/to/sessions

# ============================================================
# 各团队配置
# ============================================================
# 各团队 opencode server 密码（自定义，API 层用同一密码连接 runtime）
TEAM_A_PASSWORD=team-a-secret-change-me
TEAM_B_PASSWORD=team-b-secret-change-me
TEAM_C_PASSWORD=team-c-secret-change-me

# ============================================================
# Docling 文档转换服务配置
# ============================================================
# 运行模式：
#   - mentor（默认）: 增强版，端口 5001，需要预下载模型到 /data/docling/models
#   - simple: 简化版，端口 5000，自动下载模型
#   - docker: Docker 容器运行（需先 load docling:offline 镜像）
DOCLING_MODE=mentor

# Docling 服务 URL（根据模式自动设置，一般不需要改）
# mentor 模式：http://host.docker.internal:5001
# simple 模式：http://host.docker.internal:5000
# docker 模式：http://docling:5000
# DOCLING_URL=http://host.docker.internal:5001

# Docling 服务端口
DOCLING_PORT=5001

# 模型路径（仅 mentor 模式）
DOCLING_MODEL_PATH=/data/docling/models
